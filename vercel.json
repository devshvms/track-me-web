{
  "version": 2,
  "rewrites": [
    {
      "source": "/blogs",
      "destination": "/blogs.html"
    },
    {
      "source": "/blogs/:slug",
      "destination": "/blog/:slug.html"
    },
    {
      "source": "/live",
      "destination": "/tracker.html"
    },
    {
      "source": "/live/",
      "destination": "/tracker.html"
    },
    {
      "source": "/live/:sessionId",
      "destination": "/tracker.html"
    },
    {
      "source": "/g",
      "destination": "/group.html"
    },
    {
      "source": "/g/",
      "destination": "/group.html"
    },
    {
      "source": "/g/:path*",
      "destination": "/group.html"
    },
    {
      "source": "/get",
      "destination": "/get.html"
    },
    {
      "source": "/r",
      "destination": "/get.html"
    },
    {
      "source": "/r/",
      "destination": "/get.html"
    },
    {
      "source": "/r/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/api/telemetry/:route",
      "destination": "/api/telemetry?route=:route"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ]
    }
  ]
}
