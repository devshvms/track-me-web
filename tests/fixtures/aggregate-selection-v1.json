{
  "version": 1,
  "canonical": "track-me-web/tests/fixtures — copy to each client, same as group-status-vectors.json",
  "note": "SCOPE_1.8.9 Part 2 §9.3 — what a selection of rides IS, before anything is drawn. The shape decides which aggregate templates a rider is offered, so a platform that calls the same selection a tour where the other calls it a collection offers a different feature on each phone. Part 1 shipped with no vectors at all and the two implementations only agreed because one was ported from the other within a day; this file is what stops the next change to either side being a silent divergence. Coordinates are real places, because the 25 km chain tolerance and the 50 km spread threshold are only meaningful against distances a rider covers.",
  "constants": {
    "chain_join_meters": 25000,
    "territory_spread_meters": 50000,
    "_chain_note": "How close one ride's finish must be to the next ride's start for the two to read as one journey. Generous on purpose: a rider who stops recording at a hotel and restarts at a petrol station next morning has not broken the trip.",
    "_spread_note": "How far apart the starts must be before a selection is coverage rather than repetition.",
    "_haversine": "Both clients use R = 6371000 m and the same formula. A different radius moves every threshold."
  },
  "shape": [
    {
      "description": "legs that continue one another are a tour",
      "legs": [
        { "start": [12.9716, 77.5946], "finish": [15.3350, 76.4600] },
        { "start": [15.3350, 76.4600], "finish": [15.9149, 75.6768] },
        { "start": [15.9149, 75.6768], "finish": [15.2993, 74.1240] }
      ],
      "expected": "tour",
      "note": "Bengaluru → Hampi → Badami → Panaji."
    },
    {
      "description": "one ride is never an aggregate",
      "legs": [{ "start": [12.9716, 77.5946], "finish": [15.3350, 76.4600] }],
      "expected": "collection"
    },
    {
      "description": "an empty selection has nothing to be",
      "legs": [],
      "expected": "collection"
    },
    {
      "description": "one broken link stops it being a tour",
      "legs": [
        { "start": [12.9716, 77.5946], "finish": [15.3350, 76.4600] },
        { "start": [15.9149, 75.6768], "finish": [15.2993, 74.1240] }
      ],
      "expected": "territory",
      "note": "Strictness is the point: drawing this as one journey would invent a leg between Hampi and Badami that nobody rode."
    },
    {
      "description": "the same commute twelve times is a collection, not a map",
      "legs": [
        { "start": [12.9716, 77.5946], "finish": [12.9352, 77.6245] },
        { "start": [12.9716, 77.5946], "finish": [12.9352, 77.6245] },
        { "start": [12.9716, 77.5946], "finish": [12.9352, 77.6245] },
        { "start": [12.9716, 77.5946], "finish": [12.9352, 77.6245] },
        { "start": [12.9716, 77.5946], "finish": [12.9352, 77.6245] },
        { "start": [12.9716, 77.5946], "finish": [12.9352, 77.6245] },
        { "start": [12.9716, 77.5946], "finish": [12.9352, 77.6245] },
        { "start": [12.9716, 77.5946], "finish": [12.9352, 77.6245] },
        { "start": [12.9716, 77.5946], "finish": [12.9352, 77.6245] },
        { "start": [12.9716, 77.5946], "finish": [12.9352, 77.6245] },
        { "start": [12.9716, 77.5946], "finish": [12.9352, 77.6245] },
        { "start": [12.9716, 77.5946], "finish": [12.9352, 77.6245] }
      ],
      "expected": "collection",
      "note": "The case that forced the distinct-stop rule. A commute chains perfectly — you finish at the office and start again from the office — and it is not a journey."
    },
    {
      "description": "scattered rides with no chain are a territory",
      "legs": [
        { "start": [12.9716, 77.5946], "finish": [12.9716, 77.5946] },
        { "start": [15.9149, 75.6768], "finish": [15.9149, 75.6768] },
        { "start": [15.2993, 74.1240], "finish": [15.2993, 74.1240] }
      ],
      "expected": "territory"
    },
    {
      "description": "a short gap between recordings still chains",
      "legs": [
        { "start": [12.9716, 77.5946], "finish": [15.3350, 76.4600] },
        { "start": [15.4000, 76.5000], "finish": [15.9149, 75.6768] }
      ],
      "expected": "tour",
      "note": "About 8 km between the finish and the next start — a hotel and a petrol station."
    },
    {
      "description": "a long gap does not chain",
      "legs": [
        { "start": [12.9716, 77.5946], "finish": [15.3350, 76.4600] },
        { "start": [15.2993, 74.1240], "finish": [15.9149, 75.6768] }
      ],
      "expected": "territory"
    },
    {
      "description": "a round trip is still a tour",
      "legs": [
        { "start": [12.9716, 77.5946], "finish": [15.3350, 76.4600] },
        { "start": [15.3350, 76.4600], "finish": [15.9149, 75.6768] },
        { "start": [15.9149, 75.6768], "finish": [12.9716, 77.5946] }
      ],
      "expected": "tour",
      "note": "Net displacement is zero and it is unmistakably a journey, which is why displacement cannot be the test."
    }
  ],
