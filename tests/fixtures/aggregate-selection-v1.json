        },
        {
          "start": [19.0760, 72.8777], "finish": [18.5204, 73.8567],
          "start_place": { "admin_area": "Maharashtra" },
          "finish_place": { "admin_area": "Maharashtra" }
        },
        {
          "start": [15.2993, 74.1240], "finish": [12.9716, 77.5946],
          "start_place": { "admin_area": "Goa" },
          "finish_place": { "admin_area": "Karnataka" }
        }
      ],
      "expected": [
        { "name": "Karnataka", "role": "visited" },
        { "name": "Maharashtra", "role": "visited" },
        { "name": "Goa", "role": "visited" }
      ],
      "note": "Goa is leg 1's finish and leg 3's start. It takes the later position, because a region that is anywhere a start is left for that start to insert — the ordering rule the two clients had to be made to agree on."
    },
    {
