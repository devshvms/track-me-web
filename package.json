{
  "name": "track-me-web",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "node scripts/write-firebase-config.js && node scripts/write-posthog-config.js",
    "test": "npm run check:theme && npm run check:landing && npm run test:unit",
    "check:theme": "node scripts/check-theme-contrast.js",
    "check:landing": "node scripts/check-landing-structure.js",
    "test:unit": "npm run test:waitlist && npm run test:notify && npm run test:admin-config && npm run test:posthog-state && npm run test:location && npm run test:group-crypto && npm run test:redis-strict && npm run test:group-model && npm run test:group-cadence && npm run test:group-scripts",
    "test:waitlist": "ts-node --project tests/tsconfig.json tests/waitlist.test.ts",
    "test:notify": "ts-node --project tests/tsconfig.json tests/notify.test.ts",
    "test:admin-config": "ts-node --project tests/tsconfig.json tests/admin-config.test.ts",
    "test:posthog-state": "node tests/posthog-state.test.mjs",
    "test:location": "ts-node --project tests/tsconfig.json tests/location.test.ts",
    "test:group-crypto": "ts-node --project tests/tsconfig.json tests/group-crypto.test.ts",
    "test:redis-strict": "ts-node --project tests/tsconfig.json tests/redis-strict.test.ts",
    "gen:group-crypto-vectors": "ts-node --project tests/tsconfig.json scripts/generate-group-crypto-vectors.ts",
    "test:group-model": "ts-node --project tests/tsconfig.json tests/group-model.test.ts",
    "test:group-cadence": "ts-node --project tests/tsconfig.json tests/group-cadence.test.ts",
    "test:group-scripts": "ts-node --project tests/tsconfig.json tests/group-store-scripts.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "adm-zip": "^0.6.0",
    "archiver": "^8.0.0",
    "dotenv": "^17.4.2",
    "firebase-admin": "13.5.0",
    "posthog-node": "^5.41.0",
    "redis": "^6.0.1",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/archiver": "^8.0.0",
    "@types/node": "^26.0.1",
    "@types/uuid": "^10.0.0",
    "@vercel/node": "^5.8.22",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
